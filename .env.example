# demo 无需密钥，只支持 README 中列明的规则指令；llm 才是真实模型模式。
AGENT_MODE=demo
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
MODEL_API_KEY=
MODEL_TIMEOUT=45
AGENT_MAX_ROUNDS=8
# 可选联网搜索：注册Tavily免费Researcher账号，只在主机填写，不发给组员。
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=1
# 本应用每月最多100次外部搜索尝试；失败保守计数，10分钟相同查询缓存不计数。
# 全主机/所有项目共用；不代表服务商其他应用用量，免费账号用完应停止，不开启付费。
WEB_SEARCH_MONTHLY_LIMIT=100
# 可选：数据库和导出文件所在目录；默认项目内 data/
# STUDYMATE_DATA_DIR=/absolute/path/to/data

# Open-Meteo非商业教学天气查询，无需额外密钥；0关闭
WEATHER_ENABLED=1
